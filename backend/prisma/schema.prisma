// Prisma schema for the AI-Assisted Secure Telemedicine System
// Mirrors Section 11 (Database / ER Requirements) of the requirements baseline,
// with the v1.1 decisions applied (Section 18):
//  - Doctor.approvalStatus supports Admin-only account activation
//  - Doctor.consultationFee (doctor sets own fee)
//  - SymptomAssessment.emergencyFlag (red-flag symptom check)
//  - FileAttachment intentionally OMITTED (FR-18 deferred out of MVP)
//
// AUTH UPDATE: Firebase Authentication has been replaced with local
// email+password auth (bcrypt hashing + JWT access/refresh tokens).
// User.firebaseUid was removed; User.password and RefreshToken were added.
//
// DOCTOR ONBOARDING UPDATE: superseding the earlier "Admin creates Doctor
// directly" decision — Doctors now self-register (role=DOCTOR,
// approvalStatus=PENDING) via POST /api/auth/register-doctor, and an Admin
// approves/rejects via /api/admin/doctors/*. Doctor gained qualification,
// registrationNumber, contactInfo (basic MVP application info — no external
// credential verification). The old Admin-direct-create endpoint
// (POST /api/doctors) still exists unchanged as an alternate path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hash — never store or return plain text
  role      Role
  createdAt DateTime @default(now())

  refreshTokens RefreshToken[]
  patient       Patient?
  doctor        Doctor?
}

// Supports refresh-token rotation/revocation (Section 8 of the auth spec):
// each issued refresh token is stored hashed, so a stolen DB dump doesn't
// hand out usable tokens, and any single token can be revoked without
// affecting the user's other sessions/devices.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Patient {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String
  dob         DateTime?
  contactInfo String?

  appointments       Appointment[]
  symptomAssessments SymptomAssessment[]
}

model Doctor {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id])
  name               String
  specializationId   String
  specialization     Specialization @relation(fields: [specializationId], references: [id])
  approvalStatus     ApprovalStatus @default(PENDING) // set PENDING on self-registration; Admin moves to APPROVED/REJECTED
  consultationFee    Decimal?       @db.Decimal(10, 2) // decision #9: doctor sets own fee
  qualification      String? // e.g. "MBBS, FCPS (Medicine)" — MVP: free text, no credential verification
  registrationNumber String? // BM&DC registration number (or equivalent) — MVP: free text, not verified against any registry
  contactInfo        String?

  availability  DoctorAvailability[]
  appointments  Appointment[]
  prescriptions Prescription[]
}

model Specialization {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  doctors            Doctor[]
  symptomAssessments SymptomAssessment[]
}

model DoctorAvailability {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)

  appointment Appointment?
}

model Appointment {
  id        String             @id @default(uuid())
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    Doctor             @relation(fields: [doctorId], references: [id])
  slotId    String             @unique
  slot      DoctorAvailability @relation(fields: [slotId], references: [id])
  status    AppointmentStatus  @default(PENDING_PAYMENT)
  createdAt DateTime           @default(now())

  payment      Payment?
  consultation Consultation?
}

model Payment {
  id            String        @id @default(uuid())
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  stripeRef     String?
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])
  startedAt     DateTime?
  endedAt       DateTime?
  status        ConsultationStatus @default(SCHEDULED)

  chatMessages ChatMessage[]
  prescription Prescription?
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  doctorId       String
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  content        String
  issuedAt       DateTime     @default(now())
}

model ChatMessage {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  senderId       String
  content        String
  sentAt         DateTime     @default(now())
}

model SymptomAssessment {
  id                      String          @id @default(uuid())
  patientId               String
  patient                 Patient         @relation(fields: [patientId], references: [id])
  symptomsData            Json
  predictedCondition      String?
  confidence              Float?
  recommendedSpecialistId String?
  recommendedSpecialist   Specialization? @relation(fields: [recommendedSpecialistId], references: [id])
  emergencyFlag           Boolean         @default(false) // decision #3: red-flag symptom check
  createdAt               DateTime        @default(now())
}

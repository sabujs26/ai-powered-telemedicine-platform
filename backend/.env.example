# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (Postgres — e.g. from Neon or Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5432/telemed?schema=public"

# Firebase Admin (service account — download from Firebase Console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI microservice
AI_SERVICE_URL=http://localhost:8000
